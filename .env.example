# Neon Postgres connection string (or local Postgres for dev)
DATABASE_URL=postgresql://user:password@host/dbname

# Congress.gov API key (free: https://api.congress.gov/sign-up/) — needed for M1 votes pipeline
CONGRESS_GOV_API_KEY=

# Set to 1 to run ingestion pipelines from recorded fixtures instead of live APIs (offline dev)
PIPELINE_FIXTURES=
